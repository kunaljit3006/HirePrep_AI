# HirePrep_AI Backend Environment Configuration

# Server Settings
PORT=8000
HOST=0.0.0.0
DEBUG=True
ENVIRONMENT=development

# Database Settings (Defaults to SQLite for local development, easily switches to PostgreSQL/Supabase)
DATABASE_URL=sqlite+aiosqlite:///./hireprep.db
# For Supabase / PostgreSQL in production:
# DATABASE_URL=postgresql+asyncpg://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# Multi-Agent LLM API Keys (Free Open-Source Providers + Gemini Fallback)
GROQ_API_KEY=
HUGGINGFACE_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=

# Coding Profile API Tokens (Optional, for higher rate limits)
GITHUB_TOKEN=

# Redis / Upstash (Optional cache & rate limiting)
REDIS_URL=

# Supabase Authentication & User Management
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-supabase-anon-public-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret
AUTH_ENABLED=True

# Azure AI Speech (Text-to-Speech) - Free 500k chars/mo via Azure Free Tier + Student Pack
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastus
AZURE_SPEECH_VOICE=

